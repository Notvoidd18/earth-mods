# ==========================================
# EARTH MODS - ENVIRONMENT CONFIGURATION
# ==========================================

# Port (configured automatically by Render; defaults to 3000 locally)
PORT=3000

# Canonical Public Production URL (Must be an absolute HTTPS URL in production)
# Example: https://earthmods.example.com
# DO NOT configure localhost as the production canonical origin.
SITE_URL=https://your-production-domain.example

# Search Engine Indexing Control
# Set to "true" ONLY on the verified canonical production deployment.
# Keep "false" on local development, test runners, staging, and preview environments.
SEO_INDEXING_ENABLED=false

# PostgreSQL Connection String on Aiven
# Note: For Aiven PostgreSQL, ensure sslmode=require is appended.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://avnadmin:example_secret_password@pg-earth-mods-example.aivencloud.com:15432/defaultdb?sslmode=require

# Session and Token Security
# Server-side cryptographic secret used to sign moderator sessions
SESSION_SECRET=change_me_to_a_minimum_32_character_random_hex_string_in_production

# Salt used to hash voter tokens (ensures hashes cannot be reversed or cross-correlated)
VOTER_SALT=change_me_to_a_minimum_32_character_random_voter_salt

# First-Admin Bootstrap Secret (Used only when running bootstrap-admin script)
ADMIN_BOOTSTRAP_SECRET=super_secure_admin_bootstrap_secret_token

# Optional: Initial Admin Seed Credentials (used by scripts/bootstrap-admin.ts)
INITIAL_ADMIN_USERNAME=archon_prime
INITIAL_ADMIN_EMAIL=directorate@earthmods.internal
INITIAL_ADMIN_PASSWORD=change_this_planetary_passphrase_now_2026!
